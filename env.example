# Copy to .env (never commit the real one). All optional; defaults suit local dev.
SERVE_FRONTEND=1                 # serve frontend/ from the API (production, single origin)
ALLOWED_ORIGINS=                 # comma-separated, only if the frontend is on a different origin
ALLOWED_ORIGIN_REGEX=            # empty = off (Codespaces regex is only a dev default)
SAFEBITE_DB_PATH=/data/safebite.db
MAX_UPLOAD_BYTES=10485760
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
TESSERACT_CMD=                   # Windows only if tesseract.exe isn't found
